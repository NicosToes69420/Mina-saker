import matplotlib.pyplot as plt
import math

x = []
siny = []
cosy = []
for i in range(0,100):
    x.append(i/10)
    cosy.append(math.cos(i/10))
    siny.append(math.sin(i/10))

plt.plot(x,siny,color ="green",  label= "sin(x)")
plt.plot(x, cosy, "b-_", label = "cos(x)") #b-- ger punkt graf


plt.title("min bazinga graf") #du borde fatta
plt.legend(loc="center") #för att skriva ut labels. annars händer inget. pos styrs av maskinen #lägg till "center" eller något för att bestämma manuelt.

plt.show()


